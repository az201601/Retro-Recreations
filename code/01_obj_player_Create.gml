// ============================================================
// obj_player 的 Create 事件（游戏开始时执行一次）
// 在 GMS 中：双击 obj_player → 选择事件 → Add Event → Create
// 然后把下面全部内容复制粘贴到代码窗口里
// ============================================================

movespd  = 2;      // 水平移动速度（像素/帧）
grav     = 0.45;   // 重力加速度（每帧增加的下落速度）
maxfall  = 6;      // 最大下落速度（防止掉太快穿过细物体）
jumpv    = -7.5;   // 起跳瞬间的向上速度（负数=向上；想跳更高就改得更小，如 -9）
fallspd  = 0;      // 当前垂直速度（内部使用，不用改）
onground = false;  // 是否站在地面上（内部使用）
face     = 1;      // 朝向：1 = 向右，-1 = 向左（内部使用）

// 初始动画
sprite_index = SPR_chip_idle;
image_speed  = 0;      // 站立不动画
image_index  = 0;
image_xscale = 1;      // 1 = 正常方向

// 第 1 关背景音乐（循环播放）
// 前提：已按指引创建了声音资源 MUS_stage1
audio_play_sound(MUS_stage1, 1, true);
