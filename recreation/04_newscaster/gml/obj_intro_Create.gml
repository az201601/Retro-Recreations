/// obj_intro : Create
// Chip 'n Dale Rescue Rangers 2 (NES, USA) - spotlight intro, title screen, player / character menus,
// night scene with the blimp, newscaster cutscene.
// One Step == one NES frame (room_speed must be 60).
// frame 0 == the first all-black frame after the copyright screen has faded out
//            (frame 156 counted from power-on in Mesen; "NES frame" = frame + 156).

texture_set_interpolation(false);   // crisp pixels

frame      = -1;    // current frame number (set to 0 by the first Step)
skip_frame = -1;    // frame on which START skipped the intro (-1 = not skipped)
fade_start = 711;   // frame on which the spotlight starts fading out (START moves this earlier)

// spotlight: position of the top-left corner of the 64x63 image,
// in 1/256 pixel units (NES 8.8 fixed point), velocity in 1/256 pixel per frame
spot_on   = false;
spot_x    = 0;
spot_y    = 0;
spot_vx   = 0;
spot_vy   = 0;
spot_fade = 0;      // sub-image of spr_spotlight: 0 = full brightness .. 3 = darkest

bg_mode    = 0;     // black mask drawn IN FRONT of the spotlight: 0 none, 1 brick wall, 2 wall + silhouettes
title_fade = -1;    // sub-image of spr_title_bg / spr_title_fg: -1 hidden, 0 = darkest .. 3 = full brightness

// ---- controller ---------------------------------------------------------------
// bits: 1 = START, 2 = SELECT, 4 = A, 8 = UP, 16 = DOWN, 32 = B   (LEFT and RIGHT do nothing on these screens)
pad_prev = 0;       // buttons that were held on the previous frame

// ---- menus ----------------------------------------------------------------------
menu_state  = 0;    // 0 "Press START button", 1 1player/2players, 2 Chip/Dale, 3 fading out, 4 black (finished)
menu_t      = 0;    // frame on which menu_state last changed
menu_cursor = 0;    // 0 = upper line, 1 = lower line
menu_from   = 0;    // while fading out: the menu the choice was made in (1 = "2players", 2 = Chip/Dale)
act_move    = false;   // a cursor button was pressed on the previous frame
act_confirm = false;   // START / A was pressed on the previous frame

global.players = 1;    // result: 1 or 2
global.p1_char = 0;    // result: character of player 1, 0 = Chip, 1 = Dale (2 players: always Chip)

// ---- sound ------------------------------------------------------------------------
snd_queue  = -1;    // sound requested this frame; it becomes audible on the next frame (like the NES sound driver)
theme_main = -1;    // playing instance of snd_title_theme      (title music without the 2nd square channel)
theme_sq2  = -1;    // playing instance of snd_title_theme_sq2  (the 2nd square channel of the title music)
sq2_unmute = -1;    // frame on which theme_sq2 becomes audible again after a menu sound effect

// ---- night scene (starts 41 frames after the last menu choice) ------------------------
// its own clock: t = frame - (menu_t + 41), t == 0 is the first visible frame
ns_done     = false;   // the scene is over (black screen, the next screen takes over)
ns_skipped  = false;   // START was pressed during the scene
ns_exit_t   = -1;      // t on which the scene started to end (START, or 1003 = end of the script)
ns_fade_at1 = -1;      // t on which START (re)starts the fade-out clock
ns_fade_at2 = -1;      // t on which the end of the script (re)starts the fade-out clock
ns_fade_t0  = -1;      // t on which the fade-out clock was last started; one step every 4 frames after it
ns_lv_bg    = 0;       // fade-out step of the background, 0 = full .. 4 = black
ns_lv_blimp = 0;       // fade-out step of the blimp
ns_lv_beam  = 0;       // fade-out step of the lit searchlight beam
ns_blimp_x  = 0;       // blimp position in 1/256 pixel (x of its nose, y of its top edge)
ns_blimp_y  = 24 * 256;
ns_blimp_lit = 0;      // 1 = the blimp is lit by the searchlights
ns_beam_mode = 0;      // searchlights: 0 off, 1 swapping every 64 frames, 2 frozen and fading out
ns_beam     = 0;       // which beam is lit: 0 = spr_prison_beam_a, 1 = spr_prison_beam_b
ns_vol      = 15;      // NES volume of the alarm, 15 .. 1
ns_alarm    = -1;      // playing instance of snd_prison_alarm
ns_alarm_skip = -1;    // t of an alarm restart that START has swallowed

// loudness of the NES square channel for volume 0..15, relative to volume 15
ns_gain[0]  = 0;     ns_gain[1]  = 0.078; ns_gain[2]  = 0.154; ns_gain[3]  = 0.228;
ns_gain[4]  = 0.301; ns_gain[5]  = 0.372; ns_gain[6]  = 0.441; ns_gain[7]  = 0.509;
ns_gain[8]  = 0.575; ns_gain[9]  = 0.640; ns_gain[10] = 0.703; ns_gain[11] = 0.765;
ns_gain[12] = 0.826; ns_gain[13] = 0.885; ns_gain[14] = 0.943; ns_gain[15] = 1;

global.skip_cutscene = false;   // result: START was pressed in the night scene (the game then goes straight to the first level)

// ---- newscaster cutscene (follows the night scene unless START was pressed there) ------
// its own clock: nt = frame - nw_t0, nt == 0 is the first visible frame
nw_t0       = 0;       // frame of nt == 0 (set when the night scene ends)
nw_done     = false;   // the cutscene is over (black screen, the first level takes over)
nw_skipped  = false;   // START was pressed during the cutscene
nw_exit_t   = -1;      // nt on which the cutscene started to end (START, or 8 frames after the last text is cleared)
nw_fade_at1 = -1;      // nt on which START (re)starts the fade-out clock
nw_fade_at2 = -1;      // nt on which the end of the script (re)starts the fade-out clock
nw_fade_t0  = -1;      // nt on which the fade-out clock was last started; one step every 4 frames after it
nw_lv       = 0;       // fade-out step of the picture, 0 = full .. 4 = black
nw_quiet    = 0;       // fade-out step of the sound, 0 = full .. 11 = silent

// text box: 25 pages, typed one character every 5 frames
nw_page      = 0;      // current page, 0..24 (25 = script finished)
nw_mode      = 0;      // 0 waiting for the page to start, 1 typing, 2 page complete
nw_wait_t0   = 0;      // nt on which the previous page was cleared (the waiting time counts from here)
nw_ti        = 0;      // number of typing steps of the page done so far
nw_next_tick = -1;     // nt of the next typing step
nw_fast      = false;  // B was held while this page was typed: one step per frame, without sound
nw_end       = -1;     // nt on which the page was complete
nw_clear_t   = -100;   // nt on which the text box was last cleared (its 6 rows go blank within 6 frames)
nw_ncol      = 0;      // typing steps done in the current line (bit 1 = the speaker's mouth is open)
nw_mouth       = 0;    // mouth of the speaker: 1 = open
nw_mouth_shown = 0;    // ... as shown on this frame (the picture is one frame behind)
nw_speaker   = -1;     // actor who speaks the current page (-1 = narrator)
nw_b_held    = false;  // B was held on the previous frame
nw_b_pressed = false;  // B went down on the previous frame
var i;
for (i = 287; i >= 0; i -= 1) nw_text[i] = 0;      // text box cells [row * 32 + column]: glyph number + 1, 0 = empty
for (i = 25; i >= 0; i -= 1) nw_gstart[i] = -1;    // nt on which the wait before page i started (-1 = not yet)
nw_gstart[0] = 0;

// actors: 0 Chip, 1 Gadget, 2 Monty, 3 Zipper, 4 Dale, 5 the star above Dale
for (i = 5; i >= 0; i -= 1)
{
    nw_seg[i]    = -1;   // the movement (row of the nw_sg_ tables) the actor is playing, -1 = not on stage yet
    nw_seg_t0[i] = 0;    // nt on which that movement started
    nw_slot[i]   = -1;   // NES object slot; it decides which actor is drawn in front
    nw_ac[i]     = 0;    // this frame's picture: cel number + 1, 0 = not shown
    nw_ax[i]     = 0;    // this frame's position
    nw_ay[i]     = 0;
}
nw_slot[0]   = 2;
nw_ball_left = -1;     // nt on which Zipper stopped hovering and flew off (-1 = not yet)
nw_ball_y    = 0;      // his y on that frame

// sound
nw_music_a   = -1;     // playing instance of snd_news_music_a  (music without the 2nd square channel)
nw_music_b   = -1;     // playing instance of snd_news_music_b  (the 2nd square channel of the music)
nw_type_at   = -100;   // nt on which the next typing sound starts
nw_type_skip = -1;     // nt of a typing step whose sound START has swallowed
nw_busy_until = -100;  // the typing sound owns the 2nd square channel up to this nt
nw_gate      = 1;      // 1 = snd_news_music_b is audible
nw_pend      = 0;      // 1 = a note of snd_news_music_b has started while the typing sound owned the channel
nw_type_snd[0] = snd_news_type_0;   // typing sound of the narrator
nw_type_snd[1] = snd_news_type_1;   // Chip
nw_type_snd[2] = snd_news_type_2;   // Gadget
nw_type_snd[3] = snd_news_type_3;   // Monty
nw_type_snd[4] = snd_news_type_4;   // the crowd (page 15)
nw_type_snd[5] = snd_news_type_5;   // Dale

// ---- newscaster cutscene: data tables --------------------------------------------------
// >>> generated by tools/capture/gen_news_gml.py - do not edit by hand
var s;
nw_pages = 25;  nw_segs = 16;
nw_music_t0 = -11;     // nt on which the music starts
nw_music_len = 1920;   // length of the music loop in frames
nw_star_first = 12;   // frame of the star's track on which it becomes visible
// Zipper: frames of his entrance before he hovers, hover picture (cel + 1; +1 = wings down), picture of the last
// 12 frames of the 252-frame cycle, hover x, page and delay after which he may leave, his exit in the track table
nw_ball_hover = 157;  nw_ball_cel = 13;  nw_ball_cel2 = 34;  nw_ball_x = 148;
nw_ball_rel_page = 16;  nw_ball_rel_off = 9;  nw_ball_first = 1823;  nw_ball_count = 157;
// Zipper: y while hovering, 12-frame cycle
s = "123123122122121121121122122123123124";
for (i = 11; i >= 0; i -= 1) nw_ball_hy[i] = real(string_copy(s, i * 3 + 1, 3));
// text box rows 3..8: delay of the row going blank when a page is cleared
nw_clear_at[8] = 6;  nw_clear_at[7] = 5;  nw_clear_at[6] = 4;  nw_clear_at[5] = 3;  nw_clear_at[4] = 2;  nw_clear_at[3] = 0;
