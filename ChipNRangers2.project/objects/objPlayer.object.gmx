        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>// ------------------------------------------------------------------ input&#xA;var kL  = keyboard_check(vk_left)  || keyboard_check(ord("A"));&#xA;var kR  = keyboard_check(vk_right) || keyboard_check(ord("D"));&#xA;var kJ  = keyboard_check(vk_up)    || keyboard_check(vk_space) || keyboard_check(ord("W")) || keyboard_check(ord("Z"));&#xA;var kJp = keyboard_check_pressed(vk_up) || keyboard_check_pressed(vk_space) || keyboard_check_pressed(ord("Z"));&#xA;var kAp = keyboard_check_pressed(ord("X")) || keyboard_check_pressed(ord("K"));&#xA;&#xA;if (!dead &amp;&amp; !global.frozen) {&#xA;    // ------------------------------------------------------------ walking&#xA;    if (kL)      { hsp = max(hsp - accel, -walkspd); facing = -1; }&#xA;    else if (kR) { hsp = min(hsp + accel,  walkspd); facing =  1; }&#xA;    else {&#xA;        hsp *= 0.72;&#xA;        if (abs(hsp) &lt; 0.12) hsp = 0;&#xA;    }&#xA;&#xA;    // ------------------------------------------------------------- jumping&#xA;    if (kJp &amp;&amp; onGround) {&#xA;        vsp      = jumpPower;&#xA;        onGround = false;&#xA;        jumpCut  = true;&#xA;        audio_play_sound(sndJump, 5, false);&#xA;    }&#xA;    if (jumpCut &amp;&amp; vsp &lt; 0 &amp;&amp; !kJ) { vsp *= 0.5; jumpCut = false; }&#xA;    if (vsp &gt;= 0) jumpCut = false;&#xA;&#xA;    // ------------------------------------------------- pick up / throw box&#xA;    if (kAp) {&#xA;        if (carrying != noone &amp;&amp; !instance_exists(carrying)) carrying = noone;&#xA;&#xA;        if (carrying == noone) {&#xA;            var c = instance_nearest(x, y - 8, objCrate);&#xA;            if (c != noone &amp;&amp; !c.carried &amp;&amp; !c.thrown) {&#xA;                if (point_distance(x, y - 8, c.x + 8, c.y + 8) &lt; 30) {&#xA;                    carrying   = c;&#xA;                    c.carried  = true;&#xA;                    c.owner    = id;&#xA;                    c.thrown   = false;&#xA;                    audio_play_sound(sndPickup, 5, false);&#xA;                }&#xA;            }&#xA;        } else {&#xA;            var c = carrying;&#xA;            c.carried = false;&#xA;            c.thrown  = true;&#xA;            c.owner   = noone;&#xA;            c.x = x + facing * 10;&#xA;            c.y = y - 14;&#xA;            c.hsp = facing * 4.2;&#xA;            c.vsp = -1.2;&#xA;            carrying = noone;&#xA;            actTimer = 10;&#xA;            audio_play_sound(sndThrow, 5, false);&#xA;        }&#xA;    }&#xA;}&#xA;&#xA;// ------------------------------------------------------------- physics&#xA;vsp += grav;&#xA;if (vsp &gt; maxfall) vsp = maxfall;&#xA;&#xA;x += hsp;&#xA;if (place_meeting(x, y, objSolid)) {&#xA;    var n = 0;&#xA;    while (place_meeting(x, y, objSolid) &amp;&amp; n &lt; 12) { x -= sign(hsp); n += 1; }&#xA;    hsp = 0;&#xA;}&#xA;&#xA;y += vsp;&#xA;if (place_meeting(x, y, objSolid)) {&#xA;    var s = sign(vsp);&#xA;    var m = 0;&#xA;    while (place_meeting(x, y, objSolid) &amp;&amp; m &lt; 12) { y -= s; m += 1; }&#xA;    if (s &gt; 0) onGround = true;&#xA;    vsp = 0;&#xA;} else {&#xA;    if (vsp &gt;= 0 &amp;&amp; place_meeting(x, y + 1, objSolid)) onGround = true;&#xA;    else if (vsp &gt; 0.2) onGround = false;&#xA;}&#xA;&#xA;// ----------------------------------------------------------------- damage&#xA;if (invuln &gt; 0) invuln -= 1;&#xA;&#xA;if (!dead &amp;&amp; invuln &lt;= 0 &amp;&amp; place_meeting(x, y, objEnemy)) {&#xA;    global.hearts -= 1;&#xA;    invuln = 100;&#xA;    vsp = -3.2;&#xA;    hsp = -facing * 1.6;&#xA;    audio_play_sound(sndHurt, 6, false);&#xA;    if (global.hearts &lt;= 0) {&#xA;        global.hearts = 0;&#xA;        dead = true;&#xA;        hsp = 0;&#xA;        alarm[0] = 80;&#xA;    }&#xA;}&#xA;&#xA;// ------------------------------------------------------------------- pit&#xA;if (!dead &amp;&amp; y &gt; room_height + 24) {&#xA;    global.hearts = 0;&#xA;    dead = true;&#xA;    alarm[0] = 40;&#xA;}&#xA;&#xA;// ------------------------------------------------------------- animation&#xA;image_xscale = facing;&#xA;&#xA;if (actTimer &gt; 0) {&#xA;    actTimer -= 1;&#xA;    sprite_index = sprPlayerAct;&#xA;    image_speed  = 0;&#xA;    image_index  = 0;&#xA;} else if (dead) {&#xA;    sprite_index = sprPlayerJump;&#xA;    image_speed  = 0;&#xA;    image_index  = 1;&#xA;} else if (!onGround) {&#xA;    sprite_index = sprPlayerJump;&#xA;    image_speed  = 0;&#xA;    image_index  = (vsp &lt; 0) ? 0 : 1;&#xA;} else if (abs(hsp) &gt; 0.35) {&#xA;    sprite_index = sprPlayerWalk;&#xA;    image_speed  = 0.55;&#xA;} else {&#xA;    sprite_index = sprPlayerIdle;&#xA;    image_speed  = 0.08;&#xA;}&#xA;</string>
          </argument>
        </arguments>
      </action>
    </event>
