diff --git a/src/drivers/libretro/libretro.c b/src/drivers/libretro/libretro.c
index e9f5247..4be514c 100644
--- a/src/drivers/libretro/libretro.c
+++ b/src/drivers/libretro/libretro.c
@@ -3496,6 +3496,15 @@ void retro_run(void)
    uint8_t *gfx;
    int32_t ssize = 0;
    bool updated  = false;
+   static int hide_checked = 0;
+   if (!hide_checked) {
+      const char *hs = getenv("FCEUMM_HIDE_SPRITES");
+      const char *hb = getenv("FCEUMM_HIDE_BG");
+      int s = (hs && hs[0] == '1') ? 1 : 0;
+      int b = (hb && hb[0] == '1') ? 1 : 0;
+      if (s || b) FCEUI_SetRenderDisable(s, b);
+      hide_checked = 1;
+   }
 
    if (environ_cb(RETRO_ENVIRONMENT_GET_VARIABLE_UPDATE, &updated) && updated)
       check_variables(false);
@@ -4485,10 +4494,36 @@ unsigned retro_get_region(void)
    return FSettings.PAL ? RETRO_REGION_PAL : RETRO_REGION_NTSC;
 }
 
+/* Private, read-only asset-extraction snapshot. Not part of the libretro ABI:
+ * 0xFCE1 -> 0x2000 mapped pattern bytes, 0x1000 mirrored nametable bytes,
+ * 0x20 palette indices, 0x100 OAM bytes, 64 x RGB palette entries (0x31E0).
+ * Access via retro_get_memory_data immediately after retro_run; the addresses
+ * in VPage have already been biased by the mapper, hence [i] not [i & 1023]. */
+#define RETRO_MEMORY_CAPTURE_PPU 0xFCE1
+#define CAPTURE_PPU_BYTES 0x31E0
+static uint8_t capture_ppu[CAPTURE_PPU_BYTES];
+
 void *retro_get_memory_data(unsigned type)
 {
    uint8_t* data;
 
+   if (type == RETRO_MEMORY_CAPTURE_PPU) {
+      unsigned i;
+      for (i = 0; i < 0x2000; i++)
+         capture_ppu[i] = VPage[i >> 10] ? VPage[i >> 10][i] : 0;
+      for (i = 0; i < 0x1000; i++)
+         capture_ppu[0x2000 + i] = vnapage[i >> 10] ? vnapage[i >> 10][i & 0x3ff] : 0;
+      memcpy(capture_ppu + 0x3000, PALRAM, 0x20);
+      memcpy(capture_ppu + 0x3020, SPRAM, 0x100);
+      for (i = 0; i < 64; i++) {
+         uint32_t rgb = retro_palette[128 + i];
+         capture_ppu[0x3120 + 3 * i + 0] = (rgb >> RED_SHIFT) & 0xff;
+         capture_ppu[0x3120 + 3 * i + 1] = (rgb >> GREEN_SHIFT) & 0xff;
+         capture_ppu[0x3120 + 3 * i + 2] = (rgb >> BLUE_SHIFT) & 0xff;
+      }
+      return capture_ppu;
+   }
+
    switch(type)
    {
       case RETRO_MEMORY_SAVE_RAM:
@@ -4531,6 +4566,9 @@ size_t retro_get_memory_size(unsigned type)
       case RETRO_MEMORY_SYSTEM_RAM:
          size = 0x800;
          break;
+      case RETRO_MEMORY_CAPTURE_PPU:
+         size = CAPTURE_PPU_BYTES;
+         break;
       default:
          size = 0;
          break;
diff --git a/src/ppu.c b/src/ppu.c
index d9a9fd7..9e93945 100644
--- a/src/ppu.c
+++ b/src/ppu.c
@@ -400,11 +400,11 @@ static int rendis = 0;
 void FCEUI_SetRenderDisable(int sprites, int bg) {
 	if (sprites >= 0) {
 		if (sprites == 2) rendis ^= 1;
-		else rendis = (rendis & ~1) | sprites ? 1 : 0;
+		else rendis = (rendis & ~1) | (sprites ? 1 : 0);
 	}
 	if (bg >= 0) {
 		if (bg == 2) rendis ^= 2;
-		else rendis = (rendis & ~2) | bg ? 2 : 0;
+		else rendis = (rendis & ~2) | (bg ? 2 : 0);
 	}
 }
 
